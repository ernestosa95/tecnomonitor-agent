# ---------------------------------------------------------------------------
# pipelines.yml — instancia de Logstash del hospital
#
# Reemplaza al arranque actual "logstash.bat -f ext_dicom_queues.conf ...".
# Con este archivo, Logstash corre los CUATRO pipelines dentro de un solo
# proceso (una sola JVM) en vez de necesitar un .bat/tarea programada por
# pipeline. Cada pipeline tiene su propio scheduler cron (el `schedule =>`
# de su `jdbc` input), así que conviven sin pisarse aunque tengan cadencias
# distintas (DICOM cada 5 min, RIS/PACS/users cada hora).
#
# INSTALACIÓN (ver docs/ELK_RIS_METRICS.md para el detalle paso a paso):
#   1. Copiar este archivo a la carpeta de config de Logstash como
#      "pipelines.yml" (reemplaza al que trae Logstash por defecto, que
#      solo tiene el pipeline "main" comentado).
#   2. Ajustar las rutas de "path.config" de cada entrada a donde
#      realmente vivan los .conf en ese servidor.
#   3. Cambiar el .bat existente: sacar el "-f ext_dicom_queues.conf" para
#      que Logstash arranque desde pipelines.yml en vez de un único archivo.
#   4. Probar cada pipeline nuevo por separado antes de este paso (ver
#      sección "Probar un pipeline de forma aislada" en la documentación).
# ---------------------------------------------------------------------------

# Pipeline existente — SIN CAMBIOS en su contenido. Solo se referencia acá
# para que siga corriendo dentro del mismo proceso.
- pipeline.id: ext_dicom_queues
  path.config: "C:/Estensa/ELK/L/pipelines/ext_dicom_queues.conf"

# --- NUEVOS: KPIs de RIS/PACS/usuarios, vía Elastic en vez de SQL directo ---
- pipeline.id: ext_ris_metrics
  path.config: "C:/Estensa/ELK/L/pipelines/ext_ris_metrics.conf"

- pipeline.id: ext_pacs_metrics
  path.config: "C:/Estensa/ELK/L/pipelines/ext_pacs_metrics.conf"

- pipeline.id: ext_users_metrics
  path.config: "C:/Estensa/ELK/L/pipelines/ext_users_metrics.conf"
